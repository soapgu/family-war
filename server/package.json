{
  "name": "family-war-server",
  "version": "3.1.0",
  "private": true,
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "test": "jest --verbose --no-cache",
    "test:watch": "jest --watch",
    "test:integration": "node tests/integration.js",
    "test:unsplash": "node tests/unsplash-integration.js",
    "unsplash:sync": "node tests/unsplash-integration.js --keep"
  },
  "dependencies": {
    "@koa/router": "^12.0.1",
    "jsonwebtoken": "^9.0.3",
    "koa": "^2.15.3",
    "koa-bodyparser": "^4.4.1",
    "socket.io": "^4.7.5",
    "unsplash-js": "^6.3.0",
    "winston": "^3.19.0"
  },
  "nodemonConfig": {
    "ignore": [
      "src/data/"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/jest": "^30.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2"
  }
}
